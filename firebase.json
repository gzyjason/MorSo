{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      ".git/**",
      ".idea/**",
      ".claude/**",
      "package.json",
      "package-lock.json",
      "index.js",
      "CLAUDE.md"
    ],
    "redirects": [
      {
        "source": "/portfolio/**",
        "destination": "/gzyjason/portfolio/",
        "type": 301
      },
      {
        "source": "/contact/**",
        "destination": "/gzyjason/contact/",
        "type": 301
      },
      {
        "source": "/terms/**",
        "destination": "/stepone/terms/",
        "type": 301
      },
      {
        "source": "/privacy/**",
        "destination": "/stepone/privacy/",
        "type": 301
      },
      {
        "source": "/faq/**",
        "destination": "/stepone/faq/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/stepone/**",
        "destination": "/stepone/index.html"
      },
      {
        "source": "/gzyjason/**",
        "destination": "/gzyjason/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
